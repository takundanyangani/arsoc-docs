---
// Home page with ARSOC logo image
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ALPHA System</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu,
          Cantarell, sans-serif;
        background: linear-gradient(135deg, #0a1628 0%, #1f2937 100%);
        color: #ffffff;
        line-height: 1.6;
        min-height: 100vh;
      }

      .container {
        text-align: center;
        padding: 60px 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        animation: pageEnter 0.6s ease-out;
      }

      @keyframes pageEnter {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .logo-wrapper {
        margin: 0 auto 40px;
        animation: logoSlide 0.8s ease-out;
      }

      @keyframes logoSlide {
        from {
          opacity: 0;
          transform: scale(0.9);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .logo {
        max-width: 180px;
        height: auto;
        display: block;
        transition:
          transform 0.3s ease,
          filter 0.3s ease;
        cursor: pointer;
      }

      .logo:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
      }

      h1 {
        font-size: 3.5rem;
        margin: 20px 0 10px 0;
        font-weight: 700;
        color: #ffffff;
        animation: slideInLeft 0.7s ease-out 0.1s backwards;
      }

      @keyframes slideInLeft {
        from {
          opacity: 0;
          transform: translateX(-30px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 20px 0;
        color: #ff9800;
        animation: slideInLeft 0.7s ease-out 0.2s backwards;
      }

      p {
        font-size: 1.1rem;
        margin: 20px auto;
        max-width: 600px;
        line-height: 1.6;
        opacity: 0.9;
        animation: slideInLeft 0.7s ease-out 0.3s backwards;
      }

      .buttons {
        margin-top: 40px;
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        animation: slideInLeft 0.7s ease-out 0.4s backwards;
      }

      .btn {
        padding: 14px 32px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 1rem;
      }

      .btn-primary {
        background: linear-gradient(135deg, #ff9800 0%, #ff8800 100%);
        color: white;
      }

      .btn-primary:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(255, 152, 0, 0.4);
      }

      .btn-secondary {
        border: 2px solid #ff9800;
        color: #ff9800;
        background: transparent;
      }

      .btn-secondary:hover {
        background: rgba(255, 152, 0, 0.1);
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(255, 152, 0, 0.2);
      }

      footer {
        text-align: center;
        padding: 40px 20px;
        border-top: 1px solid rgba(255, 152, 0, 0.2);
        margin-top: 80px;
        opacity: 0.85;
        font-size: 0.95rem;
        width: 100%;
      }

      footer p {
        margin: 8px auto;
        font-size: 0.95rem;
        text-align: center;
        max-width: 100%;
      }

      footer strong {
        color: #ff9800;
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
      }

      /* Mobile responsive */
      @media (max-width: 768px) {
        h1 {
          font-size: 2.5rem;
        }

        h2 {
          font-size: 1.25rem;
        }

        p {
          font-size: 1rem;
        }

        .btn {
          padding: 12px 24px;
          font-size: 0.95rem;
        }

        .logo {
          max-width: 150px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="logo-wrapper">
        <img
          id="themeLogoImg"
          src="/logo-light.png"
          alt="Alpha System Logo"
          class="logo"
        />
      </div>

      <h1>ALPHA System</h1>

      <h2>Credit Sales Management Platform</h2>

      <p>
        Streamline inventory management, agent coordination, and loan processing
        in one integrated ecosystem.
      </p>

      <div class="buttons">
        <a href="/getting-started/" class="btn btn-primary">Get Started</a>
        <a href="/troubleshooting/" class="btn btn-secondary">Get Help</a>
      </div>
    </div>

    <footer>
      <p><strong>© 2025 ARSOC. All rights reserved.</strong></p>
      <p>ALPHA System is a registered trademark of ARSOC.</p>
      <p>
        For support: <strong>support@arsoc.co.zw</strong> | Website: <strong
          >www.arsoc.co.zw</strong
        >
      </p>
    </footer>

    <script is:inline>
      function updateLogo() {
        const img = document.getElementById("themeLogoImg");
        const theme =
          localStorage.getItem("starlight-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        img.src = theme === "dark" ? "/logo-dark.png" : "/logo-light.png";
      }

      updateLogo();
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          updateLogo();
        }
      });
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateLogo);
    </script>
  </body>
</html>
