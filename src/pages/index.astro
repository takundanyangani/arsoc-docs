---
// Home page for ALPHA System
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ALPHA System</title>
    <style>
      :root {
        color-scheme: light dark;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu,
          Cantarell, sans-serif;
        background: var(--sl-color-bg, #ffffff);
        color: var(--sl-color-text, #000000);
      }

      @media (prefers-color-scheme: dark) {
        body {
          background: var(--sl-color-bg, #1a1a1a);
          color: var(--sl-color-text, #ffffff);
        }
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background-color: var(--sl-color-bg);
        color: var(--sl-color-text);
        line-height: 1.6;
      }

      .container {
        text-align: center;
        padding: 60px 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .logo {
        max-width: 200px;
        margin: 0 auto 40px;
        display: block;
      }

      h1 {
        font-size: 3.5rem;
        margin: 20px 0 10px 0;
        font-weight: 700;
      }

      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 20px 0;
        opacity: 0.9;
      }

      p {
        font-size: 1.1rem;
        margin: 20px auto;
        max-width: 600px;
        line-height: 1.6;
        opacity: 0.85;
      }

      .buttons {
        margin-top: 40px;
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 12px 28px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        font-size: 1rem;
      }

      .btn-primary {
        background: #3b82f6;
        color: white;
      }

      .btn-primary:hover {
        background: #2563eb;
      }

      .btn-secondary {
        border: 2px solid #3b82f6;
        color: #3b82f6;
        background: transparent;
      }

      .btn-secondary:hover {
        background: rgba(59, 130, 246, 0.1);
      }

      footer {
        text-align: center;
        padding: 40px 20px;
        border-top: 1px solid var(--sl-color-gray-5);
        margin-top: 80px;
        opacity: 0.75;
        font-size: 0.9rem;
        width: 100%;
      }

      footer p {
        margin: 5px auto;
        max-width: 100%;
      }
      html[data-theme="dark"] {
        background-color: #1a1a1a;
        color: #ffffff;
      }
      html[data-theme="light"] {
        background-color: #ffffff;
        color: #000000;
      }

      body {
        background-color: inherit;
        color: inherit;
        transition:
          background-color 0.3s,
          color 0.3s;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img
        id="themeLogoImg"
        src="/logo-light.png"
        alt="ALPHA System Logo"
        class="logo"
      />

      <h1>ALPHA System</h1>

      <h2>A Comprehensive Credit Sales Management Platform</h2>

      <p>
        Streamline inventory management, agent coordination, and loan processing
        in one integrated ecosystem.
      </p>

      <div class="buttons">
        <a href="/getting-started/" class="btn btn-primary">Get Started</a>
        <a href="/troubleshooting/" class="btn btn-secondary">Learn More</a>
      </div>
    </div>

    <footer>
      <p><strong>© 2025 ARSOC. All rights reserved.</strong></p>
      <p>ALPHA System is a registered trademark of ARSOC.</p>
      <p>
        For support: <strong>support@arsoc.co.zw</strong> | Website: <strong
          >www.arsoc.co.zw</strong
        >
      </p>
    </footer>

    <script is:inline>
      function updateTheme() {
        const theme =
          localStorage.getItem("starlight-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        // Update HTML element with theme class
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;

        // Update logo
        const img = document.getElementById("themeLogoImg");
        img.src = theme === "dark" ? "/logo-dark.png" : "/logo-light.png";
      }

      // Update on page load
      updateTheme();

      // Listen for Starlight theme changes
      window.addEventListener("storage", (e) => {
        if (e.key === "starlight-theme") {
          updateTheme();
        }
      });

      // Also listen to system theme changes
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", updateTheme);
    </script>
  </body>
</html>
